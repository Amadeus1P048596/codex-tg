CTR_GO_TELEGRAM_BOT_TOKEN=<telegram-bot-token>
CTR_GO_ALLOWED_USER_IDS=<telegram-user-id>
# Applies full access without approvals to new, resumed and forked threads.
# Set false to retain configured/saved thread permissions instead.
CTR_GO_FULL_ACCESS=true
# Keep Telegram slash-command suggestions enabled.
CTR_GO_TELEGRAM_COMMAND_MENU_DISABLED=false
CTR_GO_DEFAULT_CWD=C:\Users\you\Projects\Codex
# Dedicated Telegram runtime home. Do not point this at the Desktop CODEX_HOME.
CTR_GO_CODEX_HOME=C:\Users\you\.codex-tg\codex-home
# Windows defaults to a codex-tg-owned CLI bundle with active/previous fallback.
# CTR_GO_CODEX_RUNTIME_MANAGED=true
# CTR_GO_CODEX_RUNTIME_DIR=C:\Users\you\.codex-tg\codex-runtime
# CTR_GO_CODEX_RUNTIME_SYNC_SECONDS=21600
# Private codex-tg Scheduled task definitions. Do not share this with Desktop.
CTR_GO_AUTOMATIONS_DIR=C:\Users\you\.codex-tg\automations
# Optional authenticated push endpoint for private-network producers.
# CTR_GO_PUSH_LISTEN=127.0.0.1:8787
# CTR_GO_PUSH_TOKEN=<at-least-32-random-characters>
CTR_GO_PROJECTS_PROJECT_PREVIEW_LIMIT=7
CTR_GO_PROJECTS_CHAT_PREVIEW_LIMIT=3
CTR_GO_CHATS_PAGE_SIZE=8

# Optional screenshot demo.
CTR_DEMO_TELEGRAM_E2E=0
CTR_DEMO_TELEGRAM_CHAT_ID=<telegram-chat-id>
CTR_DEMO_KEEP_MESSAGES=false
